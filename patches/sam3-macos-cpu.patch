+def edt_cpu_fallback(data: torch.Tensor) -> torch.Tensor:
+    """SciPy-based CPU/MPS fallback when triton is unavailable (e.g. macOS)."""
+    from scipy.ndimage import distance_transform_edt
+    assert data.dim() == 3
+    B, _, _ = data.shape
+    device, dtype = data.device, torch.float32
+    cpu_data = data.detach().cpu().numpy()
+    out = torch.empty(data.shape, dtype=dtype)
+    for i in range(B):
+        # Triton EDT measures distance to the nearest "0" pixel of the input;
+        # match that semantics: invert before scipy's transform.
+        out[i] = torch.from_numpy(distance_transform_edt(1 - cpu_data[i]).astype("float32"))
+    return out.to(device)
+
